# Vera engine, self-hosted. Copy to .env and fill in.

# --- Required -----------------------------------------------------------
# Supabase project URL and secret (service role) key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=
# Claude powers every AI step
ANTHROPIC_API_KEY=
# Admin key for the engine's internal API; the dashboard and edge functions
# send it as X-API-Key. Generate one: openssl rand -hex 32
API_SECRET_KEY=
# Company and people search, firmographics, job postings and news
APOLLO_API_KEY=

# --- Self-hosted mode ---------------------------------------------------
# No plan caps, and the engine runs its own daily scheduler
SELF_HOSTED=true
# Hour (UTC, 0-23) of the daily monitor pass and digest email
MONITOR_HOUR_UTC=4
# Public URL of your dashboard, no trailing slash (links in emails and Slack point here)
DASHBOARD_URL=http://localhost:3000
# Address that receives operator alerts (the daily monitor didn't run); empty = no alert emails
OPERATOR_EMAIL=
# Resend API key and verified sender address; leave empty to send no email
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Optional data providers (leave empty to switch off) -----------------
# Deep company research and AI classification via OpenRouter (Perplexity, GPT-4o mini)
OPENROUTER_API_KEY=
# Company events: funding, hires, expansion
PREDICTLEADS_API_KEY=
PREDICTLEADS_API_TOKEN=
# News and breach search, and the onboarding website scan
TAVILY_API_KEY=
# LinkedIn checks on key people and competitor watch
APIFY_API_KEY=
# Email addresses for unlocked contacts
FINDYMAIL_API_KEY=
# Dark-web credential leak signals
LEAK_RADAR_API_KEY=
# UK company revenue (free key from developer.company-information.service.gov.uk)
COMPANIES_HOUSE_API_KEY=

# --- Operations -----------------------------------------------------------
# Redis job queue; empty = jobs run in-process
REDIS_URL=
# Error reporting
SENTRY_DSN=
ENVIRONMENT=production
LOG_LEVEL=INFO
# Interactive API docs at /docs (off by default)
API_DOCS_ENABLED=false
# Claude models used for heavier and lighter AI steps
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_FAST_MODEL=claude-haiku-4-5-20251001
# Sender name on Vera's emails
RESEND_FROM_NAME=Vera
